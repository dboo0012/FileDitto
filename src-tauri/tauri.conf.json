{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileDitto",
  "version": "0.1.0",
  "identifier": "com.fileditto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileDitto",
        "width": 1366,
        "height": 768
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FileDitto",
    "category": "Utility",
    "shortDescription": "Convert media files with ease using FFmpeg",
    "longDescription": "FileDitto is a powerful desktop application that leverages FFmpeg to convert video, audio, and image files. Features include batch processing, metadata management, and format selection.",
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": null,
      "allowDowngrades": true
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
